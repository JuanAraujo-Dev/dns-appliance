#!/usr/bin/env bash
# Wrapper: se não houver TTY, grava env mínimo e aplica (útil em cloud-init)
set -euo pipefail
if [[ ! -t 0 ]] && [[ "${1:-}" != "--force" ]]; then
  echo "Sem TTY — pulando wizard interativo. Configure com: dns-firstboot --force"
  exit 0
fi
exec /opt/dns-appliance/bin/dns-firstboot "$@"
