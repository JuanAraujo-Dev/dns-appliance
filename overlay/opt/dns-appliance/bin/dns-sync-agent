#!/bin/bash
# Agente HTTP mínimo de sync (porta 5389 localhost/peer)
set -euo pipefail
APPLIANCE_ROOT="/opt/dns-appliance"
# shellcheck disable=SC1091
source "$APPLIANCE_ROOT/lib/common.sh"
load_env
SYNC_DIR=/var/lib/dns-appliance/sync
mkdir -p "$SYNC_DIR"

python3 - <<'PY'
import os, hashlib
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

SECRET = os.environ.get("CLUSTER_SECRET", "")
SYNC = Path("/var/lib/dns-appliance/sync")
SYNC.mkdir(parents=True, exist_ok=True)

class H(BaseHTTPRequestHandler):
    def _auth(self):
        return self.headers.get("X-Cluster-Secret") == SECRET and SECRET

    def do_GET(self):
        if self.path != "/latest" or not self._auth():
            self.send_response(403); self.end_headers(); return
        p = SYNC / "latest.enc"
        if not p.exists():
            self.send_response(404); self.end_headers(); return
        data = p.read_bytes()
        self.send_response(200)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_PUT(self):
        if self.path != "/upload" or not self._auth():
            self.send_response(403); self.end_headers(); return
        n = int(self.headers.get("Content-Length", "0"))
        data = self.rfile.read(n)
        (SYNC / "incoming.enc").write_bytes(data)
        (SYNC / "latest.enc").write_bytes(data)
        self.send_response(204); self.end_headers()

    def log_message(self, *args):
        return

# inject secret from env file
import subprocess
env = {}
for line in Path("/etc/dns-appliance.env").read_text().splitlines():
    if "=" in line and not line.startswith("#"):
        k,v = line.split("=",1)
        env[k.strip()] = v.strip().strip('"').strip("'")
os.environ["CLUSTER_SECRET"] = env.get("CLUSTER_SECRET", "")
SECRET = os.environ["CLUSTER_SECRET"]
HTTPServer(("0.0.0.0", 5389), H).serve_forever()
PY
