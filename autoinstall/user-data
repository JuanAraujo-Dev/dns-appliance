# cloud-config
# Ubuntu 24.04 Autoinstall — DNS Appliance (Technitium + portal + blockpage)
autoinstall:
  version: 1
  locale: pt_BR.UTF-8
  keyboard:
    layout: br
  identity:
    hostname: dns01
    username: dnsadmin
    # Senha inicial do SO: Mudar@123 — troque no wizard / primeiro login
    password: "$6$jkIdjRoC63rLusJj$Zy7XHeUvLzuPr1HRgvN7a.uGIBrhE0iJBYK1Wy06Bco5TGpd84vGEDWCEifzWSwaxj807UpwrCtl21j/KGh810"
  ssh:
    install-server: true
    allow-pw: true
  storage:
    layout:
      name: lvm
  packages:
    - nginx
    - nftables
    - fail2ban
    - certbot
    - python3-certbot-nginx
    - curl
    - wget
    - openssl
    - whiptail
    - jq
    - unzip
    - dnsutils
  user-data:
    disable_root: false
    timezone: America/Sao_Paulo
    runcmd:
      - [ bash, -lc, "systemctl enable dns-firstboot.service || true" ]
  late-commands:
    - curtin in-target --target=/target -- bash -c "mkdir -p /opt/dns-appliance-src"
    - cp -a /cdrom/dns-appliance/. /target/opt/dns-appliance-src/
    - curtin in-target --target=/target -- bash -c "chmod +x /opt/dns-appliance-src/install/*.sh /opt/dns-appliance-src/overlay/opt/dns-appliance/bin/* || true"
    - curtin in-target --target=/target -- bash -c "bash /opt/dns-appliance-src/install/install-all.sh >> /var/log/dns-appliance-install.log 2>&1 || true"
    - curtin in-target --target=/target -- bash -c "systemctl enable dns-firstboot.service || true"
