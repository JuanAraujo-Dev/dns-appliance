[Unit]
Description=DNS Appliance first-boot wizard
After=network-online.target dns.service
Wants=network-online.target
ConditionPathExists=!/var/lib/dns-appliance/configured

[Service]
Type=oneshot
Environment=TERM=linux
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=tty
ExecStart=/opt/dns-appliance/bin/dns-firstboot-safe
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
