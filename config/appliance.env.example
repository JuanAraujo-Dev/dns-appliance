# DNS Appliance v2 — configuração white-label do provedor
# Instalado em /etc/dns-appliance.env (chmod 600)

# --- Branding ---
COMPANY_NAME="Meu Provedor"
BRAND_PRIMARY="#ff5a00"
BRAND_ACCENT="#ff7a25"
SUPPORT_PHONE=""
SUPPORT_URL=""
SUPPORT_EMAIL="noc@meuprovedor.com.br"
BLOCK_LEGAL_TEXT="O acesso a este domínio foi bloqueado pela política de segurança da rede."
LOGO_FILE="/opt/dns-appliance/branding/logo.png"

# --- Identidade ---
DNS_FQDN="dns01.meuprovedor.com.br"
HOSTNAME="dns01"

# --- Rede do nó ---
INTERFACE=""
IPV4_ADDRESS="192.0.2.10/24"
IPV4_GATEWAY="192.0.2.1"
IPV6_ADDRESS=""
IPV6_GATEWAY=""
DNS_RESOLVERS="1.1.1.1,8.8.8.8"

# --- ACL (obrigatório em produção) ---
# Prefixos dos clientes autorizados a usar o recursivo (vírgula)
CLIENT_CIDRS="192.0.2.0/24,10.0.0.0/8"
# Prefixos autorizados a acessar /admin e API de gestão
MGMT_CIDRS="192.0.2.0/24"

# --- Cluster / HA ---
# standalone | cluster
DEPLOY_MODE="standalone"
# keepalived | bgp
HA_MODE="keepalived"
VIP_ADDRESS=""
VIP_IPV6=""
VRRP_ID="51"
VRRP_PRIORITY="100"
CLUSTER_PEER=""
CLUSTER_SECRET=""
# node1 (MASTER preferencial) | node2
CLUSTER_NODE="node1"

# BGP (somente HA_MODE=bgp)
BGP_ASN=""
BGP_ROUTER_ID=""
BGP_NEIGHBORS=""
BGP_VIP_PREFIX=""

# --- Admin ---
ADMIN_USER="admin"
ADMIN_PASSWORD=""

# --- TLS ---
ENABLE_LETSENCRYPT="false"
LETSENCRYPT_EMAIL="noc@meuprovedor.com.br"
ENABLE_DOT="true"
ENABLE_DOH="true"

# --- Query Logs ---
QUERYLOG_MAX_DAYS="30"
QUERYLOG_MAX_RECORDS="1000000"

# --- Feeds ---
ENABLE_THREAT_FEEDS="true"
FEED_UPDATE_CRON="0 */6 * * *"

# --- Limits ---
ENABLE_DNSSEC_VALIDATION="true"
CLIENT_RATE_LIMIT_QPS="100"
