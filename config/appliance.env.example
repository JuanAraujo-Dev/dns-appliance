# DNS Appliance — configuração do provedor
# Copiado para /etc/dns-appliance.env no first-boot / wizard

COMPANY_NAME="Meu Provedor"
DNS_FQDN="dns01.meuprovedor.com.br"
HOSTNAME="dns01"

# Rede (deixe INTERFACE vazio para detectar a primeira interface UP)
INTERFACE=""
IPV4_ADDRESS="192.0.2.10/24"
IPV4_GATEWAY="192.0.2.1"
IPV6_ADDRESS=""
IPV6_GATEWAY=""
DNS_RESOLVERS="1.1.1.1,8.8.8.8"

# Admin Technitium / portal (troque no primeiro login)
ADMIN_USER="admin"
ADMIN_PASSWORD="Mudar@123"

# Branding
LOGO_FILE="/opt/dns-appliance/branding/logo.png"

# TLS do portal (Let's Encrypt). Se false, gera certificado autoassinado.
ENABLE_LETSENCRYPT="false"
LETSENCRYPT_EMAIL="noc@meuprovedor.com.br"

# Query Logs
QUERYLOG_MAX_DAYS="30"
QUERYLOG_MAX_RECORDS="1000000"
