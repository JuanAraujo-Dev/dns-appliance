# Blockpage HTTP no VIP/IP (sink CustomAddress) — sem HTTPS self-signed feio
server {
    listen {{VIP}}:80 default_server;
    listen {{IPV4}}:80 default_server;
    {{IPV6_LISTEN_80_DEFAULT}}
    server_name _;

    root /var/www/dns-blockpage;
    index index.html;

    access_log /var/log/nginx/dns-blockpage-access.log;
    error_log  /var/log/nginx/dns-blockpage-error.log warn;

    location = /logo.png { try_files /logo.png /logo.svg =404; expires 1h; }
    location = /logo.svg { try_files /logo.svg =404; expires 1h; }

    location / {
        try_files $uri /index.html;
    }
}
