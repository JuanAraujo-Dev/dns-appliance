<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<meta name="theme-color" content="{{BRAND_PRIMARY}}">
<base href="/portal/">
<title>DNS Portal | {{COMPANY_NAME}}</title>
<link rel="stylesheet" href="css/main.css">
<link rel="stylesheet" href="css/brand.css">
</head>
<body>
<div id="loading" class="loading-overlay hidden"><div class="spinner"></div></div>

<div id="login-screen" class="login-screen hidden">
  <div class="login-card">
    <div class="login-logo">
      <div class="logo-wrap logo-wrap--login"><img src="assets/logo.png" alt="{{COMPANY_NAME}}" onerror="this.src='assets/logo.svg'"></div>
      <div class="login-logo-text">
        <h1>DNS Portal</h1>
        <p>{{DNS_FQDN}}</p>
      </div>
    </div>
    <div id="login-error" class="error-msg hidden"></div>
    <form id="login-form">
      <div class="form-group">
        <label for="login-user">Usuário</label>
        <input type="text" id="login-user" autocomplete="username" required>
      </div>
      <div class="form-group">
        <label for="login-pass">Senha</label>
        <input type="password" id="login-pass" autocomplete="current-password" required>
      </div>
      <button type="submit" id="login-btn" class="btn btn-primary">Entrar</button>
    </form>
  </div>
</div>

<div id="app" class="hidden">
  <div class="app-layout">
    <aside id="sidebar" class="sidebar">
      <div class="sidebar-header">
        <div class="logo-wrap logo-wrap--sidebar"><img src="assets/logo.png" alt="{{COMPANY_NAME}}" onerror="this.src='assets/logo.svg'"></div>
        <div><h2>DNS Portal</h2><span id="brand-name">{{COMPANY_NAME}}</span></div>
      </div>
      <nav class="sidebar-nav">
        <button class="nav-item active" data-view="dashboard" type="button">Dashboard</button>
        <button class="nav-item" data-view="logs" type="button">Logs</button>
        <button class="nav-item" data-view="clients" type="button">Top Clientes</button>
        <button class="nav-item" data-view="domains" type="button">Top Domínios</button>
        <button class="nav-item" data-view="blocked" type="button">Políticas</button>
        <button class="nav-item" data-view="network" type="button">Redes / ACL</button>
        <button class="nav-item" data-view="cluster" type="button">Cluster</button>
        <button class="nav-item" data-view="encrypted" type="button">DoH / DoT</button>
        <a class="nav-item" href="/admin/" target="_blank" rel="noopener">Admin Technitium</a>
      </nav>
      <div class="sidebar-footer">
        <button id="logout-btn" class="btn btn-secondary btn-sm" type="button">Sair</button>
      </div>
    </aside>
    <main class="main-content">
      <header class="topbar">
        <div class="topbar-left">
          <button id="menu-toggle" class="menu-toggle" type="button" aria-label="Menu">☰</button>
          <h1 id="page-title">Dashboard</h1>
          <p><span id="runtime-fqdn">{{DNS_FQDN}}</span> · <span id="user-name">Admin</span></p>
        </div>
        <div class="topbar-right">
          <span id="health-pill" class="health-pill">…</span>
          <select id="period-select" class="period-select">
            <option value="LastHour">Última Hora</option>
            <option value="LastDay">Último Dia</option>
            <option value="LastWeek">Última Semana</option>
          </select>
          <select id="refresh-select" class="refresh-select">
            <option value="30">↻ 30s</option>
            <option value="60">↻ 60s</option>
            <option value="0">↻ Off</option>
          </select>
        </div>
      </header>
      <div class="page-content">
        <div id="view-dashboard" class="view">
          <div id="stats-grid" class="stats-grid"></div>
          <div class="charts-grid">
            <div class="chart-card"><h3>Consultas</h3><canvas id="mainChart" height="220"></canvas></div>
            <div class="chart-card"><h3>Respostas</h3><canvas id="responseChart" height="220"></canvas></div>
          </div>
        </div>
        <div id="view-logs" class="view hidden">
          <div class="table-card">
            <div class="table-header">
              <h3>Logs de Consultas</h3>
              <div class="table-filters">
                <input type="text" id="filter-client" placeholder="IP cliente">
                <input type="text" id="filter-domain" placeholder="Domínio">
                <input type="datetime-local" id="filter-start">
                <input type="datetime-local" id="filter-end">
                <button id="filter-btn" class="btn btn-primary btn-sm" type="button">Filtrar</button>
                <button id="export-btn" class="btn btn-secondary btn-sm" type="button">CSV</button>
              </div>
            </div>
            <div class="table-wrap"><table><thead><tr><th>Hora</th><th>Cliente</th><th>Domínio</th><th>Tipo</th><th>Resposta</th><th>Código</th></tr></thead><tbody id="logs-tbody"></tbody></table></div>
            <div class="table-footer"><span id="logs-total">0</span><div class="pagination" id="logs-pages"></div></div>
          </div>
        </div>
        <div id="view-clients" class="view hidden"><div class="chart-card"><h3>Top Clientes</h3><ul id="top-clients-list" class="top-list"></ul></div></div>
        <div id="view-domains" class="view hidden"><div class="chart-card"><h3>Top Domínios</h3><ul id="top-domains-list" class="top-list"></ul></div></div>
        <div id="view-blocked" class="view hidden">
          <div id="block-status" class="block-status"></div>
          <div id="block-msg" class="block-msg hidden"></div>
          <div class="table-card">
            <div class="table-header">
              <h3>Domínios bloqueados</h3>
              <div class="table-filters block-toolbar">
                <input type="text" id="block-domain-input" placeholder="Novo domínio…">
                <button id="block-add-btn" class="btn btn-primary btn-sm" type="button">Bloquear</button>
                <input type="text" id="block-search" placeholder="Filtrar…">
                <button id="block-refresh-btn" class="btn btn-secondary btn-sm" type="button">Atualizar</button>
                <button id="block-export-btn" class="btn btn-secondary btn-sm" type="button">Exportar</button>
                <button id="block-bulk-toggle" class="btn btn-secondary btn-sm" type="button">Importar lote</button>
              </div>
            </div>
            <div id="block-bulk-panel" class="block-bulk-panel hidden">
              <label for="block-bulk-input">Um domínio por linha</label>
              <textarea id="block-bulk-input" rows="4"></textarea>
              <div class="block-bulk-actions">
                <button id="block-import-btn" class="btn btn-primary btn-sm" type="button">Importar</button>
                <button id="block-bulk-close" class="btn btn-secondary btn-sm" type="button">Fechar</button>
              </div>
            </div>
            <div class="table-wrap block-list-wrap"><table><thead><tr><th>#</th><th>Domínio</th><th>Ação</th></tr></thead><tbody id="blocked-tbody"></tbody></table></div>
            <div class="table-footer"><span id="blocked-total">0</span></div>
          </div>
          <div class="two-col" style="margin-top:16px">
            <div class="chart-card"><h3>Mais bloqueados</h3><ul id="top-blocked-list" class="top-list"></ul></div>
            <div class="chart-card">
              <h3>Exceções</h3>
              <div class="block-allow-form">
                <input type="text" id="allow-domain-input" placeholder="domínio liberado">
                <button id="allow-add-btn" class="btn btn-secondary btn-sm" type="button">Permitir</button>
              </div>
              <ul id="allowed-list" class="top-list allowed-inline"></ul>
            </div>
          </div>
        </div>
        <div id="view-network" class="view hidden">
          <div class="chart-card">
            <h3>ACL de recursão (CLIENT_CIDRS)</h3>
            <p class="muted">Somente estas redes consultam o DNS. Alterar exige reaplicar no nó (dns-firstboot / env).</p>
            <pre id="acl-client" class="code-block"></pre>
            <h3 style="margin-top:20px">Gestão (MGMT_CIDRS)</h3>
            <pre id="acl-mgmt" class="code-block"></pre>
          </div>
        </div>
        <div id="view-cluster" class="view hidden">
          <div class="stats-grid" id="cluster-stats"></div>
          <div class="chart-card"><h3>Estado do cluster</h3><pre id="cluster-json" class="code-block"></pre></div>
        </div>
        <div id="view-encrypted" class="view hidden">
          <div class="chart-card">
            <h3>DNS criptografado</h3>
            <p>DoH: <code id="doh-url"></code></p>
            <p>DoT: <code id="dot-host"></code>:853</p>
            <pre class="code-block" id="enc-snippet"></pre>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>
<script src="js/charts-lite.js"></script>
<script src="js/app.js"></script>
</body>
</html>
